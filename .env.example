# Discord Developer Portal > Bot > Token
DISCORD_TOKEN=
# General Information > Application ID
DISCORD_CLIENT_ID=
# 개발 서버 ID. 설정하면 해당 서버에만 명령어 등록, 비워두면 전역 등록.
DISCORD_GUILD_ID=
# Google Cloud Text-to-Speech API를 활성화한 프로젝트의 제한된 API 키
GOOGLE_TTS_API_KEY=
# 선택: 설정 새로고침을 허용할 추가 봇 운영자 ID (쉼표 구분)
BOT_OWNER_IDS=
# 선택: 설정 및 저장 경로 (프로젝트 루트 기준)
BOT_CONFIG_PATH=config/bot.json
BOT_MESSAGES_PATH=config/messages.json
BOT_DATABASE_PATH=data/sole.sqlite
